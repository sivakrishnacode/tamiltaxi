# Copy to .env (used by docker compose). Never commit real secrets.
POSTGRES_USER=tamiltaxi
POSTGRES_PASSWORD=tamiltaxi
POSTGRES_DB=tamiltaxi
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=3000
NODE_ENV=production
# At least 32 characters in production: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string-32chars
JWT_EXPIRES_IN=30d
# true = demo: DEV_OTP_CODE signs in (and the WhatsApp code, if WATX_API_KEY is set); false = only the WhatsApp code
OTP_DEV_MODE=true
# The one OTP that works in dev mode. Required when NODE_ENV=production. CHANGE IT on any public server.
DEV_OTP_CODE=123456
# Store-review numbers (comma-separated, 10 digits or +91…): no WhatsApp code is sent to them, they sign in with
# OTP_REVIEW_CODE (6 digits, required with them), in live mode too. Give them only test data.
OTP_REVIEW_PHONES=
OTP_REVIEW_CODE=
# WATX (app.watx.in) API key: login codes on WhatsApp. Required when OTP_DEV_MODE=false in production.
WATX_API_KEY=
CORS_ORIGINS=*
SEED_ON_START=true

# Google Maps Platform server key (Places API (New), Geocoding API, Routes API). Leave empty to use local data.
GOOGLE_MAPS_API_KEY=

# Phones that sign in to the admin panel as ADMIN (comma-separated, 10 digits or +91…)
ADMIN_PHONES=9000000001

# Public origin of the admin app, where live trip links point (<SHARE_BASE_URL>/track/<token>).
# e.g. https://admin.example.com
SHARE_BASE_URL=http://localhost:3001

# Admin panel (apps/admin, Next.js) host port
ADMIN_PORT=3001
# true once the admin panel is served over HTTPS (session cookie gets the Secure flag)
ADMIN_COOKIE_SECURE=false
# Browser key for the Google Maps JavaScript API used by the admin maps (baked in at build time)
GOOGLE_MAPS_BROWSER_KEY=

# Didit identity checks (business.didit.me). Empty key = off: drivers are approved on RC + insurance alone.
DIDIT_API_KEY=
DIDIT_WEBHOOK_SECRET=
DIDIT_DRIVER_WORKFLOW_ID=
DIDIT_RIDER_WORKFLOW_ID=

# HTTPS via Caddy (`docker compose --profile https up -d`, ports 80/443 open). Your domain, or sslip.io names for
# a bare IP (api.<ip-with-dashes>.sslip.io).
API_HOST=api.example.com
ADMIN_HOST=admin.example.com
