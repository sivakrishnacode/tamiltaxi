# Copy to .env.local for `npm run dev -w @tamiltaxi/admin`.
# Tamil Taxi API base URL (server side only; the browser never calls the API directly).
API_URL=http://localhost:3000/v1
# Browser key for the Google Maps JavaScript API (admin maps). Restrict by HTTP referrer in production.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
# Map ID (JavaScript, vector) in the same Google Cloud project as the key: its map style gives the maps their look and
# its Locality layer the city boundaries. Empty = the built-in look, no boundaries (using.tech.md, "City boundary").
NEXT_PUBLIC_GOOGLE_MAP_ID=
# Second Map ID whose style hides Google's places (cloud-map-style-no-places.json): the maps' "Places" switch.
NEXT_PUBLIC_GOOGLE_MAP_ID_NO_PLACES=
