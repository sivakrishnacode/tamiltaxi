# Local development (npm run start:dev -w @tamiltaxi/api) against `docker compose up -d postgres redis`.
DATABASE_URL="postgresql://tamiltaxi:tamiltaxi@localhost:5432/tamiltaxi?schema=public"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="dev-only-change-me"
PORT=3000
# true = demo: outside production any 6 digits except 000000 sign in (or only DEV_OTP_CODE, if set)
OTP_DEV_MODE=true
DEV_OTP_CODE=
# WATX (app.watx.in) API key: login codes on WhatsApp. Empty = not sent (dev mode logs them).
WATX_API_KEY=

# Google Maps Platform server key (Places API (New), Geocoding API, Routes API). Leave empty to use local data.
GOOGLE_MAPS_API_KEY=

# Phones that sign in to the admin panel as ADMIN (comma-separated, 10 digits or +91…)
ADMIN_PHONES=9000000001

# Public origin of the admin app: live trip links are <SHARE_BASE_URL>/track/<token>
SHARE_BASE_URL=http://localhost:3001

# Didit identity checks (business.didit.me). Empty key = off: drivers are approved on RC + insurance alone.
DIDIT_API_KEY=
DIDIT_WEBHOOK_SECRET=
DIDIT_DRIVER_WORKFLOW_ID=
DIDIT_RIDER_WORKFLOW_ID=
