// Tamil Taxi database schema (PostgreSQL). Money is stored in whole rupees (Int), matching the fare engine.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PASSENGER
  DRIVER
  ADMIN
}

enum Gender {
  FEMALE
  MALE
  PREFER_NOT_TO_SAY
}

enum WorkType {
  RIDES
  DELIVERIES
}

/// Ride tiers BIKE … SUV (CAB is the "Mini" hatchback; AUTO_PRIORITY is a booking tier served by AUTO drivers,
/// never a driver's vehicle), then goods vehicles.
enum VehicleKind {
  BIKE
  SCOOTY
  AUTO
  AUTO_PRIORITY
  CAB
  SEDAN
  SUV
  GOODS_BIKE
  /// Parcel on Auto (booking tier, up to 100 kg inside the auto): passenger autos that take parcels, and goods 3-wheelers.
  AUTO_PARCEL
  THREE_WHEELER
  MINI_TRUCK
  PICKUP
  TRUCK
}

enum DriverStatus {
  PENDING
  APPROVED
  REJECTED
  ON_HOLD
}

enum KycDocType {
  DRIVING_LICENCE
  AADHAAR
  VEHICLE_RC
  INSURANCE
  POLICE_VERIFICATION
}

enum KycStatus {
  NOT_UPLOADED
  UNDER_REVIEW
  VERIFIED
  REJECTED
}

/// Selfie + ID check with Didit (drivers: required; riders: optional "Verified" badge).
enum IdentityStatus {
  NOT_STARTED
  IN_PROGRESS
  IN_REVIEW
  APPROVED
  DECLINED
}

enum IdentityPurpose {
  DRIVER
  RIDER
}

enum TripKind {
  RIDE
  PARCEL
}

/// LOCAL: a ride or parcel priced by distance and time. RENTAL: a cab by the hour (package, settled from the actual km
/// and time). OUTSTATION: a cab to another town, one way or round trip.
enum RideMode {
  LOCAL
  RENTAL
  OUTSTATION
}

enum TripStatus {
  /// Booked for later (rentals and outstation): dispatch starts `scheduledDispatchLeadMin` before [Trip.scheduledAt].
  SCHEDULED
  SEARCHING
  NO_DRIVERS
  DRIVER_ASSIGNED
  DRIVER_ARRIVED
  IN_PROGRESS
  PICKED_UP
  COMPLETED
  DELIVERED
  CANCELLED
}

/// Who ended (or gave up on) a trip.
enum CancelledBy {
  PASSENGER
  DRIVER
  SYSTEM
  ADMIN
}

/// Why a trip was cancelled. Passenger: CHANGED_MIND, DRIVER_TOO_FAR, DRIVER_ASKED_TO_CANCEL, WAIT_TOO_LONG,
/// BOOKED_BY_MISTAKE. Driver: PASSENGER_NO_SHOW (only after the wait, see noShowWaitMin), PASSENGER_UNREACHABLE,
/// PASSENGER_ASKED_TO_CANCEL, VEHICLE_ISSUE, TOO_FAR, BUTTERFLY_MISMATCH (Butterfly rider is not a woman). System:
/// NO_DRIVERS, DRIVER_NOT_MOVING, STUCK. OTHER for anyone. See trips/cancel-codes.ts.
enum CancelCode {
  CHANGED_MIND
  DRIVER_TOO_FAR
  DRIVER_ASKED_TO_CANCEL
  WAIT_TOO_LONG
  BOOKED_BY_MISTAKE
  PASSENGER_NO_SHOW
  PASSENGER_UNREACHABLE
  PASSENGER_ASKED_TO_CANCEL
  VEHICLE_ISSUE
  TOO_FAR
  BUTTERFLY_MISMATCH
  NO_DRIVERS
  DRIVER_NOT_MOVING
  STUCK
  OTHER
}

/// Who was at fault for a cancellation (trips/cancel-fault.ts). SHARED = both sides or unclear (counts against nobody).
enum CancelFault {
  DRIVER
  PASSENGER
  NONE
  SHARED
}

/// A cancellation fee owed by a passenger: PENDING until it is added to their next completed ride, then APPLIED.
enum DueStatus {
  PENDING
  APPLIED
}

/// Why a driver was paused (DriverBlock). Only the cancellation rate for now.
enum DriverBlockReason {
  CANCELLATION_RATE
}

/// Who pressed SOS on a trip.
enum SafetyParty {
  PASSENGER
  DRIVER
}

/// An SOS in the admin queue: OPEN → ACKNOWLEDGED (someone is on it) → RESOLVED or FALSE_ALARM.
enum SosStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  FALSE_ALARM
}

/// A safety signal on a trip (safety module): a long stop mid-ride, a route deviation, a night check-in push, or an
/// SOS raised on it.
enum SafetyEventKind {
  STOP
  DEVIATION
  NIGHT_CHECK
  SOS_LINKED
}

enum PaymentMode {
  CASH
  UPI
}

enum ParcelPayer {
  SENDER
  RECEIVER
}

/// Butterfly (women riders only): NONE = any driver, PREFERRED = women drivers first, ONLY = women drivers only.
enum WomenDriverPref {
  NONE
  PREFERRED
  ONLY
}

enum PlanPeriod {
  DAILY
  WEEKLY
  MONTHLY
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  GRACE
  EXPIRED
  PAUSED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum ZoneKind {
  /// Higher demand: shown to drivers as "High demand" and can carry a surge multiplier.
  SURGE
  /// Informational demand hotspot (no price change).
  DEMAND
  /// No pickups or drops allowed (e.g. restricted areas).
  NO_SERVICE
  /// Airport / railway station style pickup points with their own rules.
  PICKUP_POINT
}

enum AnnouncementAudience {
  ALL
  PASSENGER
  DRIVER
}

enum AppKind {
  PASSENGER
  DRIVER
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

model User {
  id                 String                 @id @default(cuid())
  phone              String                 @unique
  name               String?
  email              String?
  gender             Gender?
  role               Role                   @default(PASSENGER)
  preferWomenDriver  Boolean                @default(false)
  autoShareTrips     Boolean                @default(true)
  /// The rider's ride OTP: one code for every ride they take themselves (Rapido style, chosen for speed: riders learn
  /// it and needn't open the app at the car). Made at the first booking; admins change it when it was overheard
  /// (trips/ride-otp.service.ts). Never sent to drivers.
  rideOtp            String?
  isBlocked          Boolean                @default(false)
  blockedReason      String?
  /// Latest Didit identity check result (mirrors the newest IdentityVerification).
  identityStatus     IdentityStatus         @default(NOT_STARTED)
  identityVerifiedAt DateTime?
  /// The account was deleted (DELETE /me or an admin): personal details wiped, [phone] is a tombstone `deleted:<id>`
  /// so the number can sign up again. Trips stay, pointing at this row (users/account-deletion.service.ts).
  deletedAt          DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  driver             Driver?
  emergencyContacts  EmergencyContact[]
  savedPlaces        SavedPlace[]
  trips              Trip[]                 @relation("PassengerTrips")
  tickets            SupportTicket[]
  devices            DeviceToken[]
  identityChecks     IdentityVerification[]
  cancellationDues   CancellationDue[]
  sosAlerts          Sos[]
  /// Admin notes about this person (driver or rider), and the ones this admin wrote.
  adminNotes         AdminNote[]            @relation("AdminNotesAbout")
  notesWritten       AdminNote[]            @relation("AdminNotesBy")

  /// Admin lists: riders / accounts by role, newest first.
  @@index([role, createdAt])
}

/// One Didit verification session. Only the last 4 digits of the document number are kept.
model IdentityVerification {
  id             String          @id @default(cuid())
  userId         String
  purpose        IdentityPurpose
  sessionId      String          @unique
  status         IdentityStatus  @default(NOT_STARTED)
  /// Didit's exact status string ("Approved", "In Review", "Kyc Expired", …).
  providerStatus String          @default("Not Started")
  documentType   String?
  documentLast4  String?
  /// Every scanned ID as [{type, last4}] (drivers: licence + Aadhaar).
  documents      Json?
  fullName       String?
  dateOfBirth    String?
  warnings       Json?
  /// What the user must fix (declined steps, plain words); shown in the apps.
  reasons        Json?
  decidedAt      DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model EmergencyContact {
  id       String @id @default(cuid())
  userId   String
  name     String
  relation String
  phone    String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SavedPlace {
  id      String  @id @default(cuid())
  userId  String
  label   String
  kind    String  @default("other") // home | work | other
  name    String
  address String
  lat     Float
  lng     Float
  note    String?
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Known places for search and reverse geocoding (seeded with Coimbatore landmarks).
model Place {
  id      String @id
  name    String
  address String
  lat     Float
  lng     Float

  @@index([name])
}

model Driver {
  id                String             @id @default(cuid())
  userId            String             @unique
  workType          WorkType           @default(RIDES)
  vehicleKind       VehicleKind
  vehicleModel      String
  vehicleColor      String             @default("")
  plate             String             @unique
  upiId             String
  /// Average of passengers' ratings (ratingSum / ratingCount, 2 decimals); 5 until the first rating.
  rating            Float              @default(5)
  ratingSum         Int                @default(0)
  ratingCount       Int                @default(0)
  ridesCount        Int                @default(0)
  status            DriverStatus       @default(PENDING)
  /// Profile photo riders see on their trip (taken in the app, matched to [selfieFile]). Private storage file.
  photoFile         String?
  photoUpdatedAt    DateTime?
  /// The live selfie from the approved Didit check: the reference a new profile photo is matched against.
  selfieFile        String?
  /// A new photo whose face match was unclear, waiting for an admin (Didit unreachable, or a low score).
  pendingPhotoFile  String?
  /// Face-match score (0–100) of the last photo checked.
  photoMatchScore   Float?
  /// Why an admin rejected the last photo.
  photoRejectReason String?
  /// Last passed daily selfie check (setting `dailySelfieCheckEnabled`): a live selfie matched to [selfieFile].
  selfieCheckedAt   DateTime?
  isOnline          Boolean            @default(false)
  /// Temporarily paused until then (too many cancellations, [DriverBlock]); can't go online, dispatch skips them.
  blockedUntil      DateTime?
  /// Booking preferences the driver set (booking-prefs.ts): maxPickupKm, minTripKm, maxTripKm, goTo {lat, lng, name,
  /// until}, stayIn {lat, lng, name, radiusKm, until}, parcels (bikes: goods-bike parcels too), areas (saved places).
  /// Dispatch only offers trips that fit. Null = no filters.
  bookingPrefs      Json?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents         KycDocument[]
  trips             Trip[]
  cancellations     TripCancellation[]
  subscriptions     Subscription[]
  /// Cancellation fees passengers owe this driver (they waited, the passenger cancelled).
  duesOwed          CancellationDue[]
  blocks            DriverBlock[]

  /// Admin lists: by status (tabs, Approvals), newest first.
  @@index([status, createdAt])
  @@index([createdAt])
}

/// A temporary pause of a driver (like Namma Yatri's DriverBlockTransactions): from [fromAt] until [untilAt], lifted
/// early by an admin ([liftedBy] / [liftedAt]). [details]: what triggered it (cancelled / assigned / rate).
model DriverBlock {
  id        String            @id @default(cuid())
  driverId  String
  reason    DriverBlockReason
  fromAt    DateTime          @default(now())
  untilAt   DateTime
  /// Admin user id who lifted it early (null = ran its course or still running).
  liftedBy  String?
  liftedAt  DateTime?
  details   Json?
  createdAt DateTime          @default(now())
  driver    Driver            @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId, fromAt])
}

model KycDocument {
  id           String     @id @default(cuid())
  driverId     String
  type         KycDocType
  status       KycStatus  @default(NOT_UPLOADED)
  rejectReason String?
  fileUrl      String?
  updatedAt    DateTime   @updatedAt
  driver       Driver     @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@unique([driverId, type])
  @@index([status, updatedAt])
}

model Trip {
  id                 String             @id @default(cuid())
  kind               TripKind
  status             TripStatus         @default(SEARCHING)
  passengerId        String
  driverId           String?
  vehicleKind        VehicleKind
  pickupName         String
  pickupAddr         String
  /// "Near KG Hospital": the pickup's landmark (Google address descriptors), shown to the driver.
  pickupLandmark     String?
  pickupLat          Float
  pickupLng          Float
  dropName           String
  dropAddr           String
  dropLat            Float
  dropLng            Float
  /// H3 cells (res 8) of pickup and drop, for heatmaps and demand stats.
  pickupCell         String?
  dropCell           String?
  distanceKm         Float
  durationMin        Int
  /// Itemised quote: base, distance, time, topUp, subtotal, multiplier, peak, waitingCharge (set at start), the waiting
  /// terms (freeWaitMin, waitPerMin, waitMaxCharge), total.
  fare               Json
  fareTotal          Int
  /// "Book any" (like Namma Yatra): other vehicles the passenger added while searching, and their quotes by kind.
  /// The first driver of any of them to accept takes the trip at that vehicle's fare.
  alsoKinds          VehicleKind[]      @default([])
  alsoFares          Json?
  otp                String
  paymentMode        PaymentMode        @default(CASH)
  /// Parcel only: category, weight band, sender/receiver details.
  parcel             Json?
  payer              ParcelPayer?
  /// Butterfly: offer the trip to women drivers first (PREFERRED) or only (ONLY).
  womenDriver        WomenDriverPref    @default(NONE)
  rideMode           RideMode           @default(LOCAL)
  /// What a rental / outstation trip agreed to (fares/ride-modes.ts RentalTerms / OutstationTerms). A rental's drop is
  /// its pickup (the rider says where on the way).
  modeTerms          Json?
  /// House shifting (a parcel trip by a goods truck with helpers): home size, the items the rider typed, floors and
  /// lifts, packing and extras, and the price lines (fares/goods-modes.ts). Always booked for a day and time slot.
  shifting           Json?
  /// Pickup time of a trip booked for later (status SCHEDULED until dispatch starts).
  scheduledAt        DateTime?
  /// When the search for a driver started (booking, or the scheduled start): dispatch widens its radius from here.
  searchFrom         DateTime           @default(now())
  /// "Who's riding?": booked for someone else (e.g. a father for his daughter). The driver sees and calls the rider.
  riderName          String?
  riderPhone         String?
  /// The rider (account holder, or [riderName]) is a woman: allows Butterfly.
  riderIsWoman       Boolean            @default(false)
  rating             Int?
  /// Free-text note with a cancel (older clients sent only this).
  cancelReason       String?
  /// Who cancelled, why (code) and when. Also set by the system on NO_DRIVERS.
  cancelledBy        CancelledBy?
  cancelCode         CancelCode?
  cancelledAt        DateTime?
  /// Times a driver dropped this trip and it went back to searching (capped by the `maxReassigns` setting).
  reassignCount      Int                @default(0)
  /// Driver's distance from the pickup when marking "Arrived", and the reason given when outside `arrivalRadiusM`.
  arrivedDistanceM   Int?
  arrivedFarReason   String?
  /// Distance from the drop when the trip was completed, and the reason when outside `dropRadiusM`.
  endDistanceM       Int?
  endFarReason       String?
  createdAt          DateTime           @default(now())
  assignedAt         DateTime?
  /// When the driver marked "Arrived" (starts the passenger no-show wait).
  arrivedAt          DateTime?
  /// arrivedAt + `noShowWaitMin`: from then the driver may cancel as PASSENGER_NO_SHOW (not held against them).
  noShowAt           DateTime?
  /// Straight-line metres from the driver to the pickup when they accepted (the "not moving" check compares to it).
  acceptDistanceM    Int?
  /// Flagged for an admin, e.g. a trip still running long after it should have ended ([reviewNote] says why).
  needsReview        Boolean            @default(false)
  reviewNote         String?
  /// Recorded GPS path (breadcrumbs, measured at completion): metres driven from start to end (null when the
  /// recording can't be trusted, see [distanceCalcFailed]) and to the pickup; fares stay the quote.
  actualDistanceM    Int?
  approachDistanceM  Int?
  /// The ride's path, simplified (~10 m) and Google-encoded, for the admin map.
  pathPolyline       String?
  /// The quoted road route (Google-encoded), copied at booking from the Routes answer the quote already fetched
  /// (Redis cache, no extra Google call); null without Google or on a cache miss. Route-deviation checks use it.
  routePolyline      String?
  /// Ride points kept after filtering, and mock-location fixes seen while on the trip.
  gpsPoints          Int                @default(0)
  gpsMockCount       Int                @default(0)
  /// Too few points or a hole of more than 2 km between kept points.
  distanceCalcFailed Boolean            @default(false)
  /// Parcel only: the sender's photo of the parcel (before pickup) and the driver's proof of delivery. Private storage
  /// files, served by GET /trips/:id/parcel-photo and /delivery-photo (trips/trip-photos.controller.ts).
  parcelPhotoFile    String?
  deliveryPhotoFile  String?
  startedAt          DateTime?
  endedAt            DateTime?
  passenger          User               @relation("PassengerTrips", fields: [passengerId], references: [id])
  driver             Driver?            @relation(fields: [driverId], references: [id])
  tickets            SupportTicket[]
  cancellations      TripCancellation[]
  /// Cancellation fees from this (cancelled) trip, and the fees this (completed) ride's fare collected.
  dues               CancellationDue[]  @relation("DueTrip")
  collectedDues      CancellationDue[]  @relation("DueAppliedTrip")
  sos                Sos[]
  safetyEvents       SafetyEvent[]

  @@index([passengerId, createdAt])
  @@index([driverId, createdAt])
  @@index([status, scheduledAt])
  @@index([status, createdAt])
  /// Admin trips list (newest first) and the dashboard's "today" counts.
  @@index([createdAt])
  @@index([needsReview])
  @@index([pickupCell])
  @@index([dropCell])
}

/// Every cancel of a trip, including a driver's cancel that sent the trip back to searching (the trip row keeps only
/// the last). Counts cancellation rates per driver / passenger: [fault] is the verdict from the [signals] (who
/// cancelled, status, arrival and wait, time since accept, moving away), [faultRule] the rule that decided;
/// [isDriverFault] = fault DRIVER (the ones held against the driver).
model TripCancellation {
  id            String      @id @default(cuid())
  tripId        String
  /// The driver the trip had when it was cancelled (null while searching).
  driverId      String?
  passengerId   String
  by            CancelledBy
  code          CancelCode
  note          String?
  /// Trip status when it was cancelled (DRIVER_ASSIGNED, DRIVER_ARRIVED, …).
  fromStatus    TripStatus
  /// The trip went back to searching for another driver instead of ending.
  reassigned    Boolean     @default(false)
  isDriverFault Boolean     @default(false)
  fault         CancelFault @default(NONE)
  faultRule     String?
  /// CancelSignals (trips/cancel-fault.ts) at the time of the cancel.
  signals       Json?
  createdAt     DateTime    @default(now())
  trip          Trip        @relation(fields: [tripId], references: [id], onDelete: Cascade)
  driver        Driver?     @relation(fields: [driverId], references: [id], onDelete: SetNull)

  @@index([tripId])
  @@index([driverId, createdAt])
  @@index([passengerId, createdAt])
}

/// A cancellation fee (setting `cancellationFeeEnabled`, off by default): the passenger cancelled after the driver
/// arrived and waited (verdict PASSENGER), so they owe [amount] to [owedToDriverId]. It is added to the passenger's
/// next completed ride as "Previous cancellation fee" and that ride's driver collects it in cash; there is no
/// settlement between drivers (this row records who it was owed to, for the admin report).
model CancellationDue {
  id             String    @id @default(cuid())
  passengerId    String
  /// The cancelled trip and its cancellation row.
  tripId         String
  cancellationId String?   @unique
  owedToDriverId String
  amount         Int
  status         DueStatus @default(PENDING)
  /// The completed ride whose fare included it.
  appliedTripId  String?
  appliedAt      DateTime?
  createdAt      DateTime  @default(now())
  passenger      User      @relation(fields: [passengerId], references: [id], onDelete: Cascade)
  trip           Trip      @relation("DueTrip", fields: [tripId], references: [id], onDelete: Cascade)
  appliedTrip    Trip?     @relation("DueAppliedTrip", fields: [appliedTripId], references: [id], onDelete: SetNull)
  owedTo         Driver    @relation(fields: [owedToDriverId], references: [id], onDelete: Cascade)

  @@index([passengerId, status])
  @@index([owedToDriverId, createdAt])
  @@index([status, createdAt])
}

/// An SOS from the passenger or driver app (safety/sos.service.ts): where they were, and what the Tamil Taxi team did.
/// Admins are pushed at once (setting `sosAdminAlert`) and work the queue on the admin SOS page.
model Sos {
  id             String      @id @default(cuid())
  tripId         String
  userId         String
  role           SafetyParty
  /// Where they were (the app's fix, else the driver's last GPS fix); null when unknown.
  lat            Float?
  lng            Float?
  status         SosStatus   @default(OPEN)
  /// What raised it: BUTTON (the SOS screen), CHECK ("Get help" on an "Is everything OK?" push), ARRIVAL ("No" to
  /// "Did you reach safely?").
  source         String      @default("BUTTON")
  /// The admin's note when resolving (or the check that raised it).
  note           String?
  acknowledgedAt DateTime?
  acknowledgedBy String?
  resolvedAt     DateTime?
  /// Admin user id who resolved it (or marked it a false alarm).
  resolvedBy     String?
  createdAt      DateTime    @default(now())
  trip           Trip        @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([tripId])
}

/// A safety signal on a trip, shown on the admin trip page. [payload] depends on [kind] (e.g. STOP: where and how
/// long; DEVIATION: metres off the route; NIGHT_CHECK: which push and the answer; SOS_LINKED: the SOS id).
model SafetyEvent {
  id      String          @id @default(cuid())
  tripId  String
  kind    SafetyEventKind
  payload Json?
  at      DateTime        @default(now())
  trip    Trip            @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, at])
  @@index([kind, at])
}

/// Price list: one row per vehicle and period (daily / weekly / monthly).
model Plan {
  id            String         @id @default(cuid())
  vehicleKind   VehicleKind
  period        PlanPeriod
  price         Int
  isActive      Boolean        @default(true)
  subscriptions Subscription[]

  @@unique([vehicleKind, period])
}

model Subscription {
  id        String             @id @default(cuid())
  driverId  String
  planId    String
  status    SubscriptionStatus @default(TRIAL)
  startsAt  DateTime           @default(now())
  endsAt    DateTime
  upiApp    String?
  autopay   Boolean            @default(true)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  driver    Driver             @relation(fields: [driverId], references: [id], onDelete: Cascade)
  plan      Plan               @relation(fields: [planId], references: [id])
  payments  Payment[]

  @@index([driverId, status])
}

model Payment {
  id             String        @id @default(cuid())
  subscriptionId String
  amount         Int
  status         PaymentStatus @default(PENDING)
  provider       String        @default("upi-autopay")
  providerRef    String?
  createdAt      DateTime      @default(now())
  subscription   Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
}

model SupportTicket {
  id             String       @id @default(cuid())
  userId         String
  tripId         String?
  topic          String
  description    String
  /// One photo the user added (e.g. a damaged parcel). Private storage file, shown to admins.
  attachmentFile String?
  status         TicketStatus @default(OPEN)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  trip           Trip?        @relation(fields: [tripId], references: [id])

  @@index([userId])
}

/// A city Tamil Taxi operates in. The service area is a set of H3 cells at [h3Resolution].
model City {
  id           String         @id // slug, e.g. "coimbatore"
  name         String
  state        String
  centerLat    Float
  centerLng    Float
  h3Resolution Int            @default(8)
  /// H3 cell indexes (strings) that make up the service area.
  serviceCells String[]
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  zones        Zone[]
  fareRules    CityFareRule[]
  modePricing  CityModePricing?
}

/// A named group of H3 cells inside a city (surge, demand hotspot, no-service, pickup point).
model Zone {
  id              String   @id @default(cuid())
  cityId          String
  name            String
  kind            ZoneKind
  cells           String[]
  /// Fare multiplier for SURGE zones (1.0–1.5).
  surgeMultiplier Float    @default(1)
  color           String   @default("#F4511E")
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  city            City     @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@index([cityId])
}

/// Per-city fare rates (fallback: built-in rates in fare-rules.ts).
model CityFareRule {
  id          String      @id @default(cuid())
  cityId      String
  vehicleKind VehicleKind
  base        Int
  perKm       Float
  perMin      Float
  minFare     Int
  /// Waiting charge per started minute after the free minutes (null = the built-in rate for the vehicle).
  waitPerMin  Int?
  isActive    Boolean     @default(true)
  updatedAt   DateTime    @updatedAt
  city        City        @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@unique([cityId, vehicleKind])
}

/// A city's own prices for the services priced up front (fares/pricing.ts): rentals, outstation, goods to another town
/// and house shifting, each a whole section. A null section uses the built-in rates.
model CityModePricing {
  cityId          String   @id
  rental          Json?
  outstation      Json?
  goodsOutstation Json?
  shifting        Json?
  updatedAt       DateTime @updatedAt
  city            City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
}

/// Every admin change (who, what, when).
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  action    String // e.g. "PATCH /admin/drivers/:id"
  entity    String
  entityId  String?
  data      Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entity, entityId])
}

/// An internal note an admin keeps on a person ("called, will re-upload RC tomorrow"). Shown on their driver and
/// account pages in the admin panel, never in the apps. Kept when the author's account goes (authorId → null).
model AdminNote {
  id        String   @id @default(cuid())
  userId    String
  authorId  String?
  body      String
  createdAt DateTime @default(now())
  user      User     @relation("AdminNotesAbout", fields: [userId], references: [id], onDelete: Cascade)
  author    User?    @relation("AdminNotesBy", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

/// In-app notices for passengers and/or drivers.
model Announcement {
  id        String               @id @default(cuid())
  audience  AnnouncementAudience @default(ALL)
  title     String
  body      String
  cityId    String?
  isActive  Boolean              @default(true)
  startsAt  DateTime             @default(now())
  endsAt    DateTime?
  createdAt DateTime             @default(now())
}

/// Key-value platform settings (e.g. currentMultiplier, searchRadiusKm, offerSeconds).
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/// Historical travel speed between two H3 cells (res 7) by hour of day (IST), built from completed trips.
/// Learned travel speed between two H3 cells of the same resolution (9, 8 and 7; ETAs use the finest with enough trips).
model HexStat {
  fromCell       String
  toCell         String
  /// H3 resolution of both cells.
  res            Int      @default(7)
  /// 0–23, IST.
  hour           Int
  trips          Int
  avgSpeedKmh    Float
  avgDurationMin Float
  updatedAt      DateTime @updatedAt

  @@id([fromCell, toCell, hour])
  @@index([fromCell])
  @@index([res, trips])
}

/// FCM registration token of a phone where a user is signed in (one row per app install).
model DeviceToken {
  token     String   @id
  userId    String
  app       AppKind
  platform  String   @default("android")
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, app])
}
